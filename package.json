{
  "name": "sample-angular-node",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "start": "node app.js",
    "dev": "nodemon --ignore frontend/ app.js",
    "dev:front": "npm --prefix frontend start",
    "test": "npm --prefix frontend test -- --watch=false"
  },
  "dependencies": {
    "body-parser": "~1.13.2",
    "cookie-parser": "~1.3.5",
    "express": "~4.2.0",
    "jwt-simple": "^0.5.5",
    "moment": "^2.22.2",
    "morgan": "~1.6.1",
    "multer": "^1.4.1",
    "mysql2": "^1.6.4",
    "sequelize": "^4.41.2",
    "sha1": "^1.1.1"
  },
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "devDependencies": {
    "nodemon": "^1.18.6"
  }
}
